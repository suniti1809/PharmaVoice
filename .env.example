# ===========================================

# PharmaVoice Environment Variables

# ===========================================

# Groq LLM API Key (Optional)

# Get free key: https://console.groq.com/keys

# Without this, app runs in rule-based mode

GROQ_API_KEY=your_groq_api_key_here

# Database URL (Optional)

# SQLite used by default (backend/pharmavoice.db)

# For PostgreSQL (production):

# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# Auto-seed database on startup (Optional)

# Default: true

AUTO_SEED=true

# ===========================================

# Instructions:

# 1. Copy this file to .env

# 2. Replace values with your actual keys

# 3. Never commit .env to GitHub!

# ===========================================
